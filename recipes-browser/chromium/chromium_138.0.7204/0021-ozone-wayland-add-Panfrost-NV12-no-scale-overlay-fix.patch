+constexpr float kV4L2NoScaleOverlayEpsilon = 0.01f;
+
+bool IsV4L2NoScaleOverlayCandidate(const OverlayCandidate& candidate) {
+  return candidate.format.is_multi_plane() &&
+         candidate.format.plane_config() ==
+             SharedImageFormat::PlaneConfig::kY_UV &&
+         candidate.format.subsampling() ==
+             SharedImageFormat::Subsampling::k420 &&
+         candidate.format.channel_format() ==
+             SharedImageFormat::ChannelFormat::k8 &&
+         std::abs(candidate.uv_rect.x()) <= kV4L2NoScaleOverlayEpsilon &&
+         std::abs(candidate.uv_rect.y()) <= kV4L2NoScaleOverlayEpsilon &&
+         std::abs(candidate.uv_rect.width() - 1.f) <=
+             kV4L2NoScaleOverlayEpsilon &&
+         std::abs(candidate.uv_rect.height() - 1.f) <=
+             kV4L2NoScaleOverlayEpsilon &&
+         std::abs(candidate.display_rect.width() -
+                  candidate.resource_size_in_pixels.width()) <=
+             kV4L2NoScaleOverlayEpsilon &&
+         std::abs(candidate.display_rect.height() -
+                  candidate.resource_size_in_pixels.height()) <=
+             kV4L2NoScaleOverlayEpsilon;
+}
 
