+             << " sqs_opacity=" << sqs->opacity
+             << " sqs_blend_mode=" << static_cast<int>(sqs->blend_mode)
+             << " sqs_clip_rect="
+             << (sqs->clip_rect ? sqs->clip_rect->ToString() : "none")
+             << " candidate_format="
